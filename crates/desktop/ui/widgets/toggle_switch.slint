export component ToggleSwitch {
    in property <bool> checked;
    callback toggled();

    width: 46px;
    height: 26px;

    Rectangle {
        background: root.checked ? #34c759 : #e5e5ea;
        border-radius: 13px;
        animate background {
            duration: 250ms;
            easing: ease-in-out;
        }

        Rectangle {
            x: root.checked ? 23px : 3px;
            y: 3px;
            width: 20px;
            height: 20px;
            background: #ffffff;
            border-radius: 10px;
            drop-shadow-color: rgba(0, 0, 0, 0.15);
            drop-shadow-blur: 4px;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 2px;
            animate x {
                duration: 300ms;
                easing: ease-out;
            }
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.toggled();
            }
        }
    }
}