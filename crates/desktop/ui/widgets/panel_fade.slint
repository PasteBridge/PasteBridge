// Reusable fade-in/fade-out container for panel transitions.
//
// Owns the full close state machine internally:
//   panel-visible  true→false  →  closing = true  →  opacity 1.0 → 0.0  →  done-closing()
//   panel-visible  false→true  →  fade in        →  opacity 0.0 → 1.0
//
// `closing` is an out-property so the parent can keep the panel mounted
// during the fade-out (e.g. `if root.settings-visible || settings-slot.closing: ...`).
//
// `flash` triggers a quick 20ms fade out, then a 200ms fade back in
// (used for the list-refresh effect).

import { AnimationTokens } from "../animations.slint";

export component PanelFadeContainer {
    in property <bool> panel-visible;
    in property <color> visible-bg;
    in-out property <bool> flash;
    out property <bool> closing: false;
    callback start-closing();
    callback done-closing();

    width: 100%;
    height: 100%;

    // Internal state machine.
    property <bool> _prev-visible: false;

    init => {
        // Sync the baseline so the first real change sees a meaningful previous value.
        root._prev-visible = root.panel-visible;
    }

    changed panel-visible => {
        // Detect true→false transition; once that fires, the timer takes over.
        if (root._prev-visible && !root.panel-visible) {
            root.closing = true;
            root.start-closing();
        }
        root._prev-visible = root.panel-visible;
    }

    // Opacity: flash takes priority over panel-visible/closing.
    //
    // Slint 语法约束:`animate` 块不能写在 `states` body 内部,必须在属性层级声明。
    // 因此 opacity 动画用单个 animate 块 + 动态 duration 表达式实现:
    //   - flash 触发时:20ms 极快淡出
    //   - closing 或隐藏时:20ms 淡出
    //   - 显示时:200ms 淡入
    // 状态机通过 states 控制 opacity 的目标值,动画时长由当前状态决定。
    opacity: 0.0;
    animate opacity {
        duration: root.flash
            ? AnimationTokens.panel-flash-out
            : (root.closing || !root.panel-visible
                ? AnimationTokens.panel-fade-out
                : AnimationTokens.panel-fade-in);
        easing: ease-out-quint;
    }
    states [
        visible when root.panel-visible && !root.flash && !root.closing: {
            opacity: 1.0;
        }
        hidden when !root.panel-visible && !root.closing && !root.flash: {
            opacity: 0.0;
        }
        closing-state when root.closing && !root.flash: {
            opacity: 0.0;
        }
        flashing when root.flash: {
            opacity: 0.0;
        }
    ]

    // Background rectangle — fills the parent component naturally.
    Rectangle {
        background: root.panel-visible ? root.visible-bg : transparent;
        animate background {
            duration: root.panel-visible ? AnimationTokens.panel-fade-in : AnimationTokens.panel-fade-out;
        }

        @children
    }

    // Closing-phase timer — fires once after the out-animation duration.
    Timer {
        interval: AnimationTokens.panel-closing-cleanup;
        running: root.closing;
        triggered => {
            root.closing = false;
            root.done-closing();
        }
    }
}
