import { ThemeManager } from "../themes.slint";

export component ContextMenu inherits PopupWindow {
    callback minimize-window();
    callback quit-app();

    width: 140px;
    height: 80px;

    Rectangle {
        background: ThemeManager.is-dark ? #2d2d2d : #ffffff;
        border-radius: 8px;
        border-width: 1px;
        border-color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.15) : rgba(0, 0, 0, 0.1);

        VerticalLayout {
            padding: 6px;
            spacing: 2px;

            Rectangle {
                height: 32px;
                background: transparent;
                border-radius: 4px;

                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 10px;

                    Text {
                        text: "— 最小化";
                        color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                        font-size: 14px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.minimize-window();
                        root.close();
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: transparent;
                border-radius: 4px;

                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 10px;

                    Text {
                        text: "× 关闭程序";
                        color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                        font-size: 14px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.quit-app();
                        root.close();
                    }
                }
            }
        }
    }
}