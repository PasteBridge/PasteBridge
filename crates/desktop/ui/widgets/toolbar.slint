import { ThemeManager } from "../themes.slint";

export component Toolbar {
    in property <bool> settings-visible;
    in property <bool> sort-ascending;
    in-out property <bool> favorite-list-visible: false;
    in property <bool> is-dragging-to-favorite: false;
    in property <bool> pinned: false;
    in property <length> mouse-window-x: 0px;
    in property <length> mouse-window-y: 0px;
    callback start-drag();
    callback toggle-settings();
    callback clear-history();
    callback toggle-sort-order();
    callback toggle-favorite();
    callback quit-app();
    callback toggle-share();
    callback toggle-pin();
    callback show-context-menu();
    callback drag-over-favorite-button();
    callback end-drag-to-favorite();
    callback cancel-drag-to-favorite();

    // 放手检测：拖拽结束时鼠标在爱心范围内 → 触发收藏夹
    changed is-dragging-to-favorite => {
        debug("toolbar.changed.is-dragging-to-favorite: ", root.is-dragging-to-favorite, " mouse-in-fav: ", favorite-btn._mouse-in-favorite, " mx:", root.mouse-window-x, " my:", root.mouse-window-y);
        if !root.is-dragging-to-favorite && favorite-btn._mouse-in-favorite {
            root.drag-over-favorite-button();
        }
    }

    width: 44px;

    Rectangle {
        background: ThemeManager.is-dark ? rgba(0, 0, 0, 0.25) : rgba(255, 255, 255, 0.948);

        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                    root.start-drag();
                }
                if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                    root.show-context-menu();
                }
            }

            VerticalLayout {
                padding-left: 10.5px;
                padding-right: 10.5px;
                padding-top: 13px;
                padding-bottom: 12px;
                spacing: 12px;

                // Hamburger-to-X toggle button
                settings-btn := Rectangle {
                    width: 26px;
                    height: 26px;
                    background: transparent;

                    property <bool> _hover: hb-ta.has-hover;

                    line1 := Rectangle {
                        x: 3px;
                        y: 8px;
                        width: 20px;
                        height: 2px;
                        background: settings-btn._hover ? #0078d4 : (ThemeManager.is-dark ? #ffffff : #1a1a1a);
                        animate background { duration: 50ms; }
                        opacity: 1.0;
                        transform-origin: { x: 10px, y: 5px };
                        transform-rotation: 0deg;
                        states [
                            state-open when root.settings-visible: {
                                transform-rotation: 30deg;
                                out {
                                    animate transform-rotation {
                                        duration: 300ms;
                                        easing: ease-out-quad;
                                    }
                                }
                                in {
                                    animate transform-rotation {
                                        duration: 300ms;
                                        easing: ease-out-quad;
                                    }
                                }
                            }
                        ]
                    }

                    line2 := Rectangle {
                        x: 3px;
                        y: 16px;
                        width: 20px;
                        height: 2px;
                        background: settings-btn._hover ? #0078d4 : (ThemeManager.is-dark ? #ffffff : #1a1a1a);
                        animate background { duration: 50ms; }
                        opacity: 1.0;
                        transform-origin: { x: 10px, y: -3px };
                        transform-rotation: 0deg;
                        states [
                            state-open when root.settings-visible: {
                                transform-rotation: -30deg;
                                out {
                                    animate transform-rotation {
                                        duration: 300ms;
                                        easing: ease-out-quad;
                                    }
                                }
                                in {
                                    animate transform-rotation {
                                        duration: 300ms;
                                        easing: ease-out-quad;
                                    }
                                }
                            }
                        ]
                    }

                    property <bool> _was-moved: false;
                    hb-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        moved => {
                            _was-moved = true;
                        }
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                                root.start-drag();
                                _was-moved = false;
                            }
                        }
                        clicked => {
                            if (!_was-moved) {
                                root.toggle-settings();
                            }
                            _was-moved = false;
                        }
                    }
                }

                // Horizontal divider
                Rectangle {
                    height: 1px;
                    background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.1);
                }

                // 工具按钮
                tool_btns := VerticalLayout {
                    spacing: 16px;

                    // Clear button
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        background: transparent;

                        property <bool> _hover: clear-ta.has-hover;

                        Image {
                            source: @image-url("../assets/delete.svg");
                            width: 20px;
                            height: 20px;
                            colorize: _hover ? #0078d4 : (ThemeManager.is-dark ? #ffffff : #1a1a1a);
                            animate colorize { duration: 50ms; }
                        }

                        clear-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.clear-history();
                            }
                        }
                    }

                    // Sort button
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        background: transparent;

                        property <bool> _hover: sort-ta.has-hover;

                        Image {
                            source: root.sort-ascending ? @image-url("../assets/clock_arrow_up.svg") : @image-url("../assets/clock_arrow_down.svg");
                            width: 20px;
                            height: 20px;
                            colorize: _hover ? #0078d4 : (ThemeManager.is-dark ? #ffffff : #1a1a1a);
                            animate colorize { duration: 50ms; }
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        sort-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.toggle-sort-order();
                            }
                        }
                    }

                    // Favorite button - uses position-based hover detection during drag
                    favorite-btn := Rectangle {
                        width: 24px;
                        height: 24px;
                        background: transparent;

                        property <bool> _hover: favorite-ta.has-hover;

                        // ── 动态坐标检测（无需硬编码偏移） ──
                        property <bool> _is-over-favorite:
                            root.is-dragging-to-favorite
                            && mouse-window-x >= root.x + tool_btns.x + favorite-btn.x
                            && mouse-window-x <= root.x + tool_btns.x + favorite-btn.x + 24px
                            && mouse-window-y >= root.y + tool_btns.y + favorite-btn.y
                            && mouse-window-y <= root.y + tool_btns.y + favorite-btn.y + 24px;

                        // 检测鼠标位置是否在爱心范围内（独立于拖拽状态，用于放手检测）
                        property <bool> _mouse-in-favorite:
                            mouse-window-x >= root.x + tool_btns.x + favorite-btn.x
                            && mouse-window-x <= root.x + tool_btns.x + favorite-btn.x + 24px
                            && mouse-window-y >= root.y + tool_btns.y + favorite-btn.y
                            && mouse-window-y <= root.y + tool_btns.y + favorite-btn.y + 24px;

                        property <bool> _highlighted: _hover || _is-over-favorite;

                        Image {
                            source: @image-url("../assets/favorite.svg");
                            width: 20px;
                            height: 20px;
                            colorize: root.favorite-list-visible || _highlighted
                                ? #0078d4
                                : (ThemeManager.is-dark ? #ffffff : #1a1a1a);
                            animate colorize { duration: 50ms; }
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        favorite-ta := TouchArea {
                            width: 100%;
                            height: 100%;

                            clicked => {
                                if !root.is-dragging-to-favorite {
                                    root.favorite-list-visible = !root.favorite-list-visible;
                                }
                            }
                        }
                    }

                    // Quit button
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        background: transparent;

                        property <bool> _hover: quit-ta.has-hover;

                        Text {
                            text: "×";
                            color: _hover ? #0078d4 : (ThemeManager.is-dark ? #ffffff : #1a1a1a);
                            animate color { duration: 50ms; }
                            font-size: 20px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        quit-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.quit-app();
                            }
                        }
                    }
                }

                // Spacer to push share button to bottom
                Rectangle {
                    vertical-stretch: 1;
                }

                // Pin (置顶) button - 位于同步按钮上方
                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: transparent;

                    property <bool> _hover: pin-ta.has-hover;

                    Image {
                        source: @image-url("../assets/pin.svg");
                        width: 20px;
                        height: 20px;
                        colorize: root.pinned || _hover
                            ? #0078d4
                            : (ThemeManager.is-dark ? #ffffff : #1a1a1a);
                        animate colorize { duration: 50ms; }
                        // 置顶时旋转 45°，直观表示"被钉住"
                        transform-rotation: root.pinned ? 45deg : 0deg;
                        animate transform-rotation { duration: 150ms; easing: ease-out; }
                    }

                    pin-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.toggle-pin();
                        }
                    }
                }

                // Share button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: transparent;

                    property <bool> _hover: share-ta.has-hover;

                    Image {
                        source: @image-url("../assets/share.svg");
                        width: 24px;
                        height: 24px;
                        colorize: _hover ? #0078d4 : (ThemeManager.is-dark ? #ffffff : #1a1a1a);
                        animate colorize { duration: 50ms; }
                    }

                    share-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.toggle-share();
                        }
                    }
                }
            }
        }
    }
}