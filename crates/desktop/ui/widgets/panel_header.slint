import { ThemeManager } from "../themes.slint";

export component PanelHeader {
    in property <string> title: "Panel";
    in property <bool> show-close-button: true;

    callback close();

    Rectangle {
        background: ThemeManager.is-dark ? rgba(30, 30, 30, 0.67) : rgba(255, 255, 255, 0.978);

        VerticalLayout {
            width: parent.width;
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.title;
                    color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                Rectangle { vertical-stretch: 0; horizontal-stretch: 1; }

                if root.show-close-button: Rectangle {
                    width: 28px;
                    height: 28px;
                    background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.05);
                    border-radius: 4px;

                    Text {
                        text: "←";
                        color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.1);
            }
        }
    }
}