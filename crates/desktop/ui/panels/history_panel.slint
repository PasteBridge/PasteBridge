import { ThemeManager } from "../themes.slint";
import { ListView } from "std-widgets.slint";
import { ContentKind, ClipboardEntryData } from "../types.slint";
import { SearchBox } from "../widgets/search_box.slint";

export component HistoryPanel {
    in property <[string]> clipboard-history;
    in property <[string]> clipboard-timestamps;
    in property <[ClipboardEntryData]> clipboard-entries;
    in-out property <int> last-visible-index: 0;
    in-out property <bool> is-dragging: false;
    in-out property <int> dragging-index: -1;
    in-out property <bool> favorite-list-visible: false;
    // 拖拽时鼠标的窗口坐标（由 Rust 侧 GetCursorPos 轮询更新）
    in-out property <length> mouse-window-x: 0px;
    in-out property <length> mouse-window-y: 0px;
    // hover 刷新计数器：每次变化时强制重置当前 hover index
    in-out property <int> hover-refresh-tick: 0;
    // 收藏夹文件夹视图
    in property <int> current-favorite-folder: -1;
    in property <string> current-favorite-folder-name: "";
    // 多选模式
    in-out property <bool> multi-select-mode: false;
    in property <[bool]> selected-states;
    in property <[string]> multi-select-texts;
    in property <int> selected-count: 0;
    // 搜索
    in-out property <string> search-query: "";
    in property <bool> has-search-results: true;
    // 当前鼠标悬浮的项索引（-1 表示无）
    in-out property <int> hovered-index: -1;
    // 悬浮项的展示文本（实时显示在搜索框）
    in-out property <string> hovered-display: "";
    // 悬浮项的内容类型标识（CF_TEXT / CF_DIB）
    in-out property <string> hovered-content-kind: "";
    // 悬浮项的次序（如 3/15）
    in-out property <string> hovered-time-order: "";
    // 来自 popup tooltip 的内容与时间戳（高优先级显示）
    in-out property <string> tooltip-text: "";
    in-out property <string> tooltip-timestamp: "";
    // 上一次的 tick 值，用于检测变化
    property <int> _last-tick: -1;
    // 拖拽时跟随鼠标的文本虚影内容
    in property <string> dragging-text: "";
    // 图片懒加载: 可见范围
    in-out property <int> visible-start-index: 0;
    in-out property <int> visible-end-index: 0;
    // 滚动防抖: 上次已触发加载的范围,避免快速滚动时重复触发
    property <int> _loaded-start: -1;
    property <int> _loaded-end: -1;
    // 图片懒加载防抖状态 (由布局内 timer 使用)
    property <bool> _image-load-pending: false;
    property <int> _pending-load-start: -1;
    property <int> _pending-load-end: -1;
    // 滚动到顶部触发属性
    in-out property <bool> scroll-to-top: false;
    // 复制动画触发属性
    in-out property <bool> copy-animation-trigger: false;
    callback copy-item(index: int);
    callback set-hovered-index(index: int);
    callback drag-over-favorite-button();
    callback end-drag-to-favorite();
    callback cancel-drag-to-favorite();
    callback drag-out-started(index: int);
    callback back-to-all-history();
    callback toggle-multi-select(index: int);
    callback toggle-selection(index: int);
    callback clear-multi-select();
    callback search-changed(query: string);
    callback load-visible-images(start-index: int, end-index: int);

    // 悬浮项变化时，构造底栏三栏信息
    //   左侧：内容类型标识（CF_TEXT / CF_DIB）
    //   中间：时间戳
    //   右边：次序（序号/总数）
    changed hovered-index => {
        if root.hovered-index >= 0 && root.hovered-index < root.clipboard-history.length {
            let ts = root.clipboard-timestamps[root.hovered-index];
            let counter = (root.hovered-index + 1) + "/" + root.clipboard-history.length;
            // 时间戳展示在中间
            root.hovered-display = ts;
            // 次序展示在右边
            root.hovered-time-order = counter;
            // 根据内容类型确定左侧标识
            if root.hovered-index < root.clipboard-entries.length {
                root.hovered-content-kind = root.clipboard-entries[root.hovered-index].content-kind == ContentKind.Image ? "CF_DIB" : "CF_TEXT";
            }
        } else {
            root.hovered-display = "";
            root.hovered-content-kind = "";
            root.hovered-time-order = "";
        }
    }

    FocusScope {
        key-pressed(ev) => {
            // Escape 键退出多选模式
            if ev.text == "" {
                if root.multi-select-mode {
                    root.clear-multi-select();
                }
            }
            // 可打印字符：直接追加到搜索查询并聚焦搜索框
            if ev.text != "" && !root.multi-select-mode {
                root.search-query += ev.text;
                search-box.set-focus();
            }
            return accept;
        }

        VerticalLayout {
            spacing: 0px;

            // 收藏夹文件夹视图头部
            if root.current-favorite-folder >= 0: Rectangle {
                min-height: 36px;
                background: ThemeManager.is-dark ? rgba(0, 120, 212, 0.15) : rgba(0, 120, 212, 0.08);

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 12px;
                    spacing: 6px;

                    // 返回箭头
                    back-btn := Rectangle {
                        width: 28px;
                        height: 28px;
                        background: back-btn-ta.has-hover
                            ? (ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.06))
                            : transparent;
                        border-radius: 4px;

                        Text {
                            text: "←";
                            color: #0078d4;
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        back-btn-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.back-to-all-history();
                            }
                        }
                    }

                    Text {
                        text: "收藏夹 > " + root.current-favorite-folder-name;
                        color: #0078d4;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }

            // 多选模式提示栏（带高度动画）
            Rectangle {
                height: root.multi-select-mode ? 40px : 0px;
                clip: true;
                background: ThemeManager.is-dark ? rgba(0, 120, 212, 0.2) : rgba(0, 120, 212, 0.1);

                animate height {
                    duration: 200ms;
                    easing: ease-out-quad;
                }

                // 顶栏内容
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    height: 40px;

                    Text {
                        text: "多选模式";
                        color: #0078d4;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    // 选中数量
                    selected-count-text := Text {
                        text: "已选 " + root.selected-count + " 项";
                        color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.7) : rgba(0, 0, 0, 0.55);
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // 退出多选按钮
                    exit-multi-select-btn := Rectangle {
                        width: 64px;
                        height: 28px;
                        background: exit-ta.has-hover
                            ? (ThemeManager.is-dark ? rgba(220, 53, 69, 0.25) : rgba(220, 53, 69, 0.15))
                            : (ThemeManager.is-dark ? rgba(220, 53, 69, 0.12) : rgba(220, 53, 69, 0.06));
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: ThemeManager.is-dark ? rgba(220, 53, 69, 0.4) : rgba(220, 53, 69, 0.3);

                        Text {
                            text: "退出";
                            color: #dc3545;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        exit-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.clear-multi-select();
                            }
                        }
                    }
                }
            }

            // 滚动到顶部定时器
            // 修复：
            //   1) 原 50ms 过短，ListView 还没完成模型更新后的重布局，
            //      viewport-y = 0 被新模型重新映射到非零位置 → 离顶部有偏移
            //   2) 之前用过的"二级 50ms 强制再滚"会导致 ListView 内部状态机
            //      被连续两次 viewport-y = 0 触发卡死，无法向下拖动
            // 改用 100ms 单级延迟，仅触发一次 viewport-y = 0，避免连续强制
            // 写入导致 ListView 状态异常。
            Timer {
                interval: 100ms;
                running: root.scroll-to-top;
                triggered => {
                    list-view.viewport-y = 0px;
                    root.scroll-to-top = false;
                }
            }

            // 图片懒加载防抖: 滚动停止 150ms 后再触发 Rust 侧加载
            Timer {
                interval: 150ms;
                running: root._image-load-pending;
                triggered => {
                    root._image-load-pending = false;
                    root._loaded-start = root._pending-load-start;
                    root._loaded-end = root._pending-load-end;
                    root.load-visible-images(root._pending-load-start, root._pending-load-end);
                }
            }

            // Clipboard history list
            // 使用 Slint 原生 Material 风格滚动条(由 SLINT_STYLE=material 决定外观)
            list-view := ListView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

                scrolled => {
                    // 一次性计算最后可见项索引(替代 per-item is_last_visible 求值，消除 N 次属性重算/帧)
                    root.last-visible-index = Math.min(
                        root.clipboard-entries.length - 1,
                        Math.max(0, Math.floor((list-view.viewport-y + list-view.visible-height) / 144px))
                    );

                    // 图片懒加载: 检测可见区域并触发加载
                    root.visible-start-index = Math.max(0, Math.floor(list-view.viewport-y / 144px) - 2);
                    root.visible-end-index = Math.min(
                        root.clipboard-entries.length - 1,
                        Math.ceil((list-view.viewport-y + list-view.visible-height) / 144px) + 2
                    );

                    // 防抖: 只在可见范围显著变化时,标记待加载(由防抖 timer 统一触发)
                    if root.visible-start-index != root._loaded-start
                        || root.visible-end-index != root._loaded-end {
                        root._pending-load-start = root.visible-start-index;
                        root._pending-load-end = root.visible-end-index;
                        root._image-load-pending = true;
                    }
                }

                // ============================================================
                // 统一渲染: 文本 + 图片 (folder view 走 favorite-folder-entries,主历史走 clipboard-entries,均为 ClipboardEntryData)
                // ============================================================
                for entry[index] in root.clipboard-entries: entry-rect := Rectangle {
                        property <bool> is-image: entry.content-kind == ContentKind.Image;
                        // 文本样式:
                        //   item-font-size = 实际字号 (Text 元素直接使用)
                        //   Slint Text 没有 line-height,实际行高 = font-size × 1.2
                        //   item-line-height = 容器 min/max 高度计算的参考值(不再等于实际行高)
                        property <length> item-font-size: 13px;
                        property <length> item-line-height: 20.5px;

                        // 选中状态
                        property <bool> is-selected: root.multi-select-mode && index < root.selected-states.length && root.selected-states[index];

                        // 高度: 图片固定 144px (12+120+12), 文本按 Text 自身 preferred-height 算
                        //   上下 padding 22px (11 顶 + 11 底),至少 1 行,最多 5 行
                        height: is-image ? 144px : Math.min(
                            Math.max(entry-text-layout.preferred-height + 22px,
                            item-line-height * 1 + 22px),
                            item-line-height * 5 + 22px
                        );
                        clip: true;

                        // 背景 - 直接切换，无动画
                        background: root.is-dragging && root.dragging-index == index
                            ? (ThemeManager.is-dark ? rgba(0, 120, 212, 0.3) : rgba(0, 120, 212, 0.15))
                            : (is-selected
                                ? (ThemeManager.is-dark ? rgba(0, 120, 212, 0.18) : rgba(0, 120, 212, 0.1))
                                : (ta.pressed ? (ThemeManager.is-dark ? rgba(120, 120, 120, 0.8) : rgba(220, 220, 220, 0.95)) :
                                  (ta.has-hover ? (ThemeManager.is-dark ? rgba(90, 90, 90, 0.6) : rgba(240, 240, 240, 0.9)) :
                                  (ThemeManager.is-dark ? rgba(61, 61, 61, 0.4) : rgba(255, 255, 255, 0.8)))));

                        // 鼠标位置的背景 spotlight 高亮 (软光晕跟随鼠标)
                        Rectangle {
                            x: ta.mouse-x - 150px;
                            y: ta.mouse-y - 150px;
                            width: 300px;
                            height: 300px;
                            background: @radial-gradient(circle, rgba(0, 120, 212, 0.25) 0%, transparent 70%);
                            opacity: ta.has-hover ? 1.0 : 0.0;
                            animate opacity { duration: 150ms; easing: linear; }
                        }

                        // 顶部水平边框: 跟随鼠标 x 移动，两端渐变 (颜色淡一点)
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 2px;
                            background: transparent;

                            property <length> seg-w: parent.width * 0.4;
                            property <length> seg-x: clamp(
                                ta.has-hover ? ta.mouse-x - seg-w / 2 : (parent.width - seg-w) / 2,
                                0px,
                                parent.width - seg-w
                            );

                            Rectangle {
                                x: seg-x;
                                y: 0px;
                                width: seg-w;
                                height: 2px;
                                background: @linear-gradient(90deg, transparent 0%, rgba(0, 120, 212, 0.55) 50%, transparent 100%);
                                opacity: (is-selected || (root.is-dragging && root.dragging-index == index))
                                    ? 1.0
                                    : (ta.has-hover ? 1.0 : 0.0);
                                animate opacity { duration: 150ms; easing: ease-out; }
                            }
                        }

                        // 底部水平边框 (同样效果)
                        Rectangle {
                            x: 0px;
                            y: parent.height - 2px;
                            width: 100%;
                            height: 2px;
                            background: transparent;

                            property <length> seg-w: parent.width * 0.4;
                            property <length> seg-x: clamp(
                                ta.has-hover ? ta.mouse-x - seg-w / 2 : (parent.width - seg-w) / 2,
                                0px,
                                parent.width - seg-w
                            );

                            Rectangle {
                                x: seg-x;
                                y: 0px;
                                width: seg-w;
                                height: 2px;
                                background: @linear-gradient(90deg, transparent 0%, rgba(0, 120, 212, 0.55) 50%, transparent 100%);
                                opacity: (is-selected || (root.is-dragging && root.dragging-index == index))
                                    ? 1.0
                                    : (ta.has-hover ? 1.0 : 0.0);
                                animate opacity { duration: 150ms; easing: ease-out; }
                            }
                        }

                        property <bool> _item_was_moved: false;
                        property <length> _press_x: 0px;
                        property <length> _press_y: 0px;
                        property <bool> _middle_scrolling: false;
                        property <length> _middle_start_y: 0px;
                        property <length> _middle_start_viewport: 0px;
                        ta := TouchArea {
                            mouse-cursor: MouseCursor.default;
                            pointer-event(ev) => {
                                if ev.kind == PointerEventKind.down {
                                    _item_was_moved = false;
                                    _press_x = ta.mouse-x;
                                    _press_y = ta.mouse-y;

                                    // 中键滚动开始
                                    if ev.button == PointerEventButton.middle {
                                        _middle_scrolling = true;
                                        _middle_start_y = ta.mouse-y;
                                        _middle_start_viewport = list-view.viewport-y;
                                        return;
                                    }

                                    // 图片暂不支持多选
                                    if !is-image && ev.modifiers.shift && ev.button == PointerEventButton.left {
                                        _item_was_moved = true;
                                        root.toggle-multi-select(index);
                                        return;
                                    }
                                } else if ev.kind == PointerEventKind.move && ta.pressed {
                                    // 中键滚动
                                    if _middle_scrolling {
                                        let delta = ta.mouse-y - _middle_start_y;
                                        list-view.viewport-y = _middle_start_viewport + delta;
                                        return;
                                    }

                                    if (ta.mouse-x - _press_x).abs() > 3px || (ta.mouse-y - _press_y).abs() > 3px {
                                        if !_item_was_moved {
                                            _item_was_moved = true;
                                            root.is-dragging = true;
                                            root.dragging-index = index;
                                            // 图片拖出 (phase 4) 暂不实现
                                            if !is-image {
                                                root.drag-out-started(index);
                                            }
                                        }
                                    }
                                } else if ev.kind == PointerEventKind.up {
                                    // 中键滚动结束
                                    if ev.button == PointerEventButton.middle {
                                        _middle_scrolling = false;
                                        return;
                                    }

                                    if !_item_was_moved && root.multi-select-mode && !is-image {
                                        root.toggle-selection(index);
                                        return;
                                    }
                                    if root.is-dragging && root.dragging-index == index {
                                        root.is-dragging = false;
                                        root.dragging-index = -1;
                                    }
                                } else if ev.kind == PointerEventKind.cancel {
                                    _middle_scrolling = false;
                                }
                            }
                            clicked => {
                                if (!_item_was_moved) {
                                    root.copy-item(index);
                                }
                            }
                        }

                        // 使用中间属性来监听 hover 状态变化
                        property <bool> is-hovering: ta.has-hover;
                        changed is-hovering => {
                            if is-hovering {
                                root.set-hovered-index(index);
                                root.hovered-index = index;
                            } else {
                                root.set-hovered-index(-1);
                                root.hovered-index = -1;
                            }
                        }

                        // 底部分隔横线
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            x: 12px;
                            width: parent.width - 24px;
                            background: ThemeManager.is-dark ? rgba(80, 80, 80, 0.4) : rgba(220, 220, 220, 0.8);
                        }

                        // === 文本裁切容器 (仅文本时显示) ===
                        // 单个 Text + wrap: word-wrap,Slint 内置换行,跟窗口宽度自动重排
                        // 实际行高 = font-size × 1.2,item-line-height 仅用于容器 min/max 高度计算
                        Rectangle {
                            y: 11px;
                            height: parent.height - 22px;
                            clip: true;
                            visible: !is-image;
                            opacity: root.is-dragging && root.dragging-index == index ? 0.35 : 1.0;
                            animate opacity { duration: 100ms; easing: ease-out; }

                            entry-text-layout := Text {
                                x: 12px;
                                width: parent.width - 24px;
                                text: entry.text;
                                color: #f1f1f3;
                                font-size: item-font-size;
                                font-weight: 300;
                                wrap: word-wrap;
                                vertical-alignment: top;
                                overflow: clip;
                            }
                        }

                        // === 图片容器 (仅图片时显示) ===
                        if is-image: Rectangle {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            height: 120px;

                            Image {
                                source: entry.image;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }

                            // 右下角信息: 尺寸 + 大小
                            Text {
                                x: parent.width - self.width - 6px;
                                y: parent.height - self.height - 4px;
                                text: entry.width + "x" + entry.height + " · " + Math.round(entry.file-size / 1024) + "KB";
                                color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.7) : rgba(0, 0, 0, 0.55);
                                font-size: 10px;
                            }
                        }
                    }
            }

            // 底部搜索栏 —— 背景与 Toolbar 统一，顶部添加边框增强分隔
            Rectangle {
                height: 40px;
                background: ThemeManager.is-dark ? rgba(0, 0, 0, 0.25) : rgba(255, 255, 255, 0.948);
                border-width: 1px;
                border-color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.12) : rgba(0, 0, 0, 0.08);

                HorizontalLayout {
                    spacing: 0px;

                    search-box := SearchBox {
                        horizontal-stretch: 1;
                        query <=> root.search-query;
                        query-changed(new-query) => {
                            root.search-changed(new-query);
                        }
                        tooltip-text: root.tooltip-text;
                        tooltip-timestamp: root.tooltip-timestamp;
                        time-indicator: root.hovered-display;
                        content-kind-label: root.hovered-content-kind;
                        time-order: root.hovered-time-order;
                    }
                }
            }

            // 无搜索结果提示
            if !root.has-search-results && root.search-query != "": Rectangle {
                height: 60px;
                background: transparent;

                Text {
                    text: "未找到匹配结果";
                    color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.5) : rgba(0, 0, 0, 0.45);
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // 拖拽文本虚影 - 跟随鼠标移动（在布局之外，使用绝对定位）
        if root.is-dragging && root.dragging-text != "": Rectangle {
                x: root.mouse-window-x + 12px;
                y: root.mouse-window-y - 8px;
                width: min(ghost-text.preferred-width + 24px, 280px);
                height: min(ghost-text.preferred-height + 16px, 80px);
                background: ThemeManager.is-dark ? rgba(26, 26, 26, 0.9) : rgba(255, 255, 255, 0.9);
                border-radius: 8px;
                border-width: 1px;
                border-color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.15) : rgba(0, 0, 0, 0.12);
                opacity: 0.75;

                ghost-text := Text {
                    x: 12px;
                    y: 8px;
                    width: parent.width - 24px;
                    text: root.dragging-text;
                    color: ThemeManager.is-dark ? #e6e6e6 : #1a1a1a;
                    font-size: 13px;
                    font-weight: 300;
                    wrap: word-wrap;
                    max-height: 56px;
                    overflow: clip;
                }
            }
    }
}
