import { ThemeManager } from "../themes.slint";
import { ScrollView } from "std-widgets.slint";
import { IssueData } from "../types.slint";

export component IssuesPanel {
    in property <[IssueData]> issues;
    callback toggle-issues();
    callback select-issue(index: int);

    Rectangle {
        background: ThemeManager.is-dark ? rgba(30, 30, 30, 0.95) : rgba(255, 255, 255, 0.99);
        
        VerticalLayout {
            width: parent.width;
            padding: 16px;
            spacing: 12px;
            
            // Header
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "GitHub Issues";
                    color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
                
                Rectangle { vertical-stretch: 0; horizontal-stretch: 1; }
                
                // Close button - returns to history
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.05);
                    border-radius: 4px;
                    
                    Text {
                        text: "←";
                        color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.toggle-issues();
                        }
                    }
                }
            }
            
            // Divider
            Rectangle {
                height: 1px;
                background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.1);
            }
            
            // Issues list
            ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;
                
                VerticalLayout {
                    spacing: 8px;
                    
                    for issue[index] in root.issues: Rectangle {
                        height: 56px;
                        background: ThemeManager.is-dark ? rgba(61, 61, 61, 0.34) : rgba(255, 255, 255, 0.840);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: rgba(128, 128, 128, 0.2);
                        
                        property <bool> animated: false;
                        
                        Timer {
                            interval: 30ms * index;
                            running: !animated;
                            triggered => {
                                animated = true;
                            }
                        }
                        
                        opacity: 0.0;
                        animate opacity {
                            duration: 250ms;
                            easing: ease-out;
                        }
                        
                        states [
                            visible when animated: {
                                opacity: 1.0;
                            }
                        ]
                        
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 4px;
                            
                            HorizontalLayout {
                                Text {
                                    text: "#" + issue.id;
                                    color: #0078d4;
                                    font-size: 12px;
                                    font-weight: 500;
                                }
                                Text {
                                    text: issue.title;
                                    color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                                    font-size: 12px;
                                    font-weight: 300;
                                    horizontal-alignment: left;
                                }
                            }
                            
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: issue.author != "" ? "@" + issue.author : "unknown";
                                    color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.5) : rgba(0, 0, 0, 0.4);
                                    font-size: 10px;
                                }
                                if issue.date != "":
                                    Text {
                                        text: issue.date;
                                        color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.5) : rgba(0, 0, 0, 0.4);
                                        font-size: 10px;
                                    }
                                if issue.milestone != "":
                                    Rectangle {
                                        background: #0078d4;
                                        border-radius: 4px;
                                        Text {
                                            text: issue.milestone;
                                            color: #ffffff;
                                            font-size: 10px;
                                        }
                                    }
                            }
                        }
                        
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.select-issue(index);
                            }
                        }
                    }
                    
                    if root.issues.length == 0:
                        VerticalLayout {
                            padding: 20px;
                            Text {
                                text: "Loading issues...";
                                color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.5) : rgba(0, 0, 0, 0.4);
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                }
            }
        }
    }
}