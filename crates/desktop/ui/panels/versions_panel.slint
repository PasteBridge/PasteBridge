import { ThemeManager } from "../themes.slint";
import { ScrollView } from "std-widgets.slint";
import { VersionData } from "../types.slint";

export component VersionsPanel {
    in property <[VersionData]> versions;
    callback toggle-versions();
    callback restore-version(version_id: int);
    callback delete-version(version_id: int);

    Rectangle {
        background: ThemeManager.is-dark ? rgba(30, 30, 30, 0.90) : rgba(255, 255, 255, 0.93);
        
        VerticalLayout {
            width: parent.width;
            padding: 16px;
            spacing: 12px;
            
            // Header
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "版本历史";
                    color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
                
                Rectangle { vertical-stretch: 0; horizontal-stretch: 1; }
                
                // Close button - returns to history
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.05);
                    border-radius: 4px;
                    
                    Text {
                        text: "←";
                        color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.toggle-versions();
                        }
                    }
                }
            }
            
            // Divider
            Rectangle {
                height: 1px;
                background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.1);
            }
            
            // Versions list
            ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;
                
                VerticalLayout {
                    spacing: 8px;
                    
                    for version[index] in root.versions: Rectangle {
                        height: 64px;
                        background: ThemeManager.is-dark ? rgba(61, 61, 61, 0.28) : rgba(255, 255, 255, 0.56);
                        border-radius: 6px;
                        border-width: 0px;
                        border-color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.05);
                        
                        property <bool> animated: false;
                        
                        Timer {
                            interval: 30ms * index;
                            running: !animated;
                            triggered => {
                                animated = true;
                            }
                        }
                        
                        opacity: 0.0;
                        animate opacity {
                            duration: 250ms;
                            easing: ease-out;
                        }
                        
                        states [
                            visible when animated: {
                                opacity: 1.0;
                            }
                        ]
                        
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 4px;
                            
                            HorizontalLayout {
                                Text {
                                    text: "v" + version.version_number;
                                    color: #0078d4;
                                    font-size: 12px;
                                    font-weight: 500;
                                }
                                if version.comment != "":
                                    Text {
                                        text: version.comment;
                                        color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.7) : rgba(0, 0, 0, 0.7);
                                        font-size: 12px;
                                        horizontal-alignment: left;
                                    }
                            }
                            
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: version.content_text;
                                    color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.5) : rgba(0, 0, 0, 0.4);
                                    font-size: 11px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                            }
                            
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: version.created_at;
                                    color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.4) : rgba(0, 0, 0, 0.3);
                                    font-size: 10px;
                                }
                            }
                        }
                        
                        // Actions
                        HorizontalLayout {
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: end;
                            
                            // Restore button
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                background: #0078d4;
                                border-radius: 4px;
                                
                                Text {
                                    text: "↺";
                                    color: #ffffff;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                
                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.restore-version(version.id);
                                    }
                                }
                            }
                            
                            // Delete button
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                background: ThemeManager.is-dark ? #555555 : #e0e0e0;
                                border-radius: 4px;
                                
                                Text {
                                    text: "✕";
                                    color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                
                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.delete-version(version.id);
                                    }
                                }
                            }
                        }
                    }
                    
                    if root.versions.length == 0:
                        VerticalLayout {
                            padding: 20px;
                            Text {
                                text: "暂无版本记录";
                                color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.5) : rgba(0, 0, 0, 0.4);
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                }
            }
        }
    }
}