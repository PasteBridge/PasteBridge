import { ThemeManager } from "../themes.slint";

export component SharePanel {
    in property <bool> share-visible;
    in property <bool> closing;
    callback done-closing();

    Timer {
        interval: 30ms;
        running: root.closing;
        triggered => { root.done-closing(); }
    }

    Rectangle {
        opacity: 1.0;
        background: root.share-visible ? (ThemeManager.is-dark ? rgba(30, 30, 30, 0.67) : rgba(255, 255, 255, 0.978)) : transparent;

        states [
            visible when root.share-visible: {
                opacity: 1.0;
                background: ThemeManager.is-dark ? rgba(30, 30, 30, 0.67) : rgba(255, 255, 255, 0.978);
                in {
                    animate opacity { duration: 200ms; easing: ease-out-quint; }
                    animate background { duration: 200ms; }
                }
                out {
                    animate opacity { duration: 20ms; easing: ease-out-quint; }
                    animate background { duration: 20ms; }
                }
            }
        ]

        if root.share-visible || root.closing: VerticalLayout {
            width: parent.width;
            padding: 16px;
            spacing: 12px;
            
            HorizontalLayout {
                spacing: 8px;
                
                Text {
                    text: "同步";
                    color: ThemeManager.is-dark ? #ffffff : #1a1a1a;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
                
                Rectangle { vertical-stretch: 0; horizontal-stretch: 1; }
                
                Rectangle {
                    width: 80px;
                    height: 28px;
                    background: ThemeManager.is-dark ? rgba(0, 120, 212, 0.3) : rgba(0, 120, 212, 0.12);
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #0078d4;
                    
                    Text {
                        text: "+ 配对设备";
                        color: #0078d4;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            // Pair device action
                        }
                    }
                }
            }
            
            Rectangle {
                height: 1px;
                background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.1);
            }
            
            VerticalLayout {
                spacing: 12px;
                
                Text {
                    text: "暂无同步设备";
                    color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.5) : rgba(0, 0, 0, 0.4);
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}