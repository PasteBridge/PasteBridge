import { ScrollView, ListView } from "std-widgets.slint";
import { ThemeManager, DarkTheme, LightTheme } from "themes.slint";
import { IssueData, VersionData } from "types.slint";
import { PanelHeader } from "widgets/panel_header.slint";
import { ToggleSwitch } from "widgets/toggle_switch.slint";
import { RadioOption } from "widgets/radio_option.slint";
import { PopupToast } from "widgets/popup_toast.slint";
import { ContextMenu } from "widgets/context_menu.slint";
import { Toolbar } from "widgets/toolbar.slint";
import { SettingsPanel } from "panels/settings_panel.slint";
import { IssuesPanel } from "panels/issues_panel.slint";
import { VersionsPanel } from "panels/versions_panel.slint";
import { SharePanel } from "panels/share_panel.slint";
import { HistoryPanel } from "panels/history_panel.slint";

export global MainContent {
    in-out property <float> opacity: 1.0;
    in-out property <bool> is-fading: false;
}

export component AppWindow inherits Window {
    title: "PasteBridge";
    default-font-family: "Microsoft YaHei, PingFang SC, SimHei, Noto Sans CJK SC, sans-serif";
    preferred-width: 280px;
    preferred-height: 396px;
    min-width: 200px;
    min-height: 300px;
    max-width: 600px;
    max-height: 800px;
    no-frame: true;
    resize-border-width: 8px;
    always-on-top: true;
    background: ThemeManager.is-dark ? #1A1A1ACD : #F5F5F5D5;

    callback minimize-window();
    callback hide-window();
    callback quit-app();
    callback start-drag();
    callback new-clipboard-entry(text: string);
    callback copy-item(index: int);
    callback clear-history();
    callback toggle-settings();
    callback toggle-favorite();
    callback toggle-share();
    callback toggle-sort-order();
    callback show-hover-tooltip(text: string);
    callback show-hover-tooltip-index(index: int);
    callback hide-hover-tooltip();
    callback set-hovered-index(index: int);
    callback on-window-moved();
    callback toggle-theme();
    callback toggle-issues();
    callback select-issue(index: int);
    callback toggle-versions();
    callback save-version(index: int);
    callback restore-version(version_id: int);
    callback delete-version(version_id: int);
    callback load-versions(parent_id: int);
    callback add-mock-data();
    callback open-popup-window(title: string, content: string);
    callback on-database-updated();
    callback save-setting(key: string, value: string);
    callback restore-focus-enabled-change(enabled: bool);

    in property <[string]> clipboard-history;
    in-out property <bool> main-content-fade-out: false;
    in property <string> placeholder-text;
    in property <[IssueData]> issues;
    in property <[VersionData]> versions;
    in property <int> current-parent-id: -1;
    
    // Settings panel visibility
    in-out property <bool> settings-visible: false;
    in-out property <bool> issues-visible: false;
    in-out property <bool> versions-visible: false;
    in-out property <bool> share-visible: false;

    // Window positioning mode: 0 = golden ratio centered, 1 = follow mouse cursor (fallback when no input focus detected)
    in-out property <int> window-position-mode: 1;
    // Two-way binding with ThemeManager for Rust access
    in-out property <bool> is-dark-mode <=> ThemeManager.is-dark;
    // Sort direction for clipboard history: false = newest first (default), true = oldest first
    in-out property <bool> sort-ascending: false;
    // Focus restoration setting: whether to restore focus to previous app after window shows
    in-out property <bool> restore-focus-enabled: true;
    
    // Scroll indicator properties
    in-out property <bool> is-scrolling: false;
    in-out property <int> last-visible-index: 0;

    // Closing animation state (keep panel in layout during fade-out)
    in-out property <bool> _settings-closing: false;
    in-out property <bool> _share-closing: false;
    // Previous values for detecting visibility transitions
    property <bool> _prev-settings-visible: false;
    property <bool> _prev-share-visible: false;

    // Detect settings-visible/share-visible transitions (true→false) to trigger closing animation
    transition-detect := Timer {
        interval: 50ms;
        running: true;
        triggered => {
            // Detect settings closing transition (true→false)
            if (root._prev-settings-visible && !root.settings-visible && !root._settings-closing) {
                root._settings-closing = true;
            }

            // Detect share closing transition (true→false)
            if (root._prev-share-visible && !root.share-visible && !root._share-closing) {
                root._share-closing = true;
            }

            // Mutual exclusion: settings and share cannot be open simultaneously
            // When settings opens while share is visible, close share with animation
            if (root.settings-visible && !root._prev-settings-visible && root.share-visible) {
                root._share-closing = true;
                root.share-visible = false;
            }
            // When share opens while settings is visible, close settings with animation
            if (root.share-visible && !root._prev-share-visible && root.settings-visible) {
                root._settings-closing = true;
                root.settings-visible = false;
            }

            root._prev-settings-visible = root.settings-visible;
            root._prev-share-visible = root.share-visible;
        }
    }

    // Copied 弹出提示
    popup := PopupToast { }
    
    // 右键上下文菜单
    context-menu := ContextMenu {
        minimize-window => { root.minimize-window(); }
        quit-app => { root.quit-app(); }
    }
    
    // Background gradient layer (底层)
    Rectangle {
        background: ThemeManager.is-dark ? rgba(0, 0, 0, 0) : rgba(255, 255, 255, 0);
    }

    // White border and shadow container
    Rectangle {
        background: ThemeManager.is-dark ? rgba(0, 0, 0, 0.12) : rgba(255, 255, 255, 0.63);
        border-width: 1px;
        border-color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.15) : rgba(0, 0, 0, 0.1);
    }


    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        //Main content area
            main-content := Rectangle {
                horizontal-stretch: 1;
                opacity: root.main-content-fade-out ? 0.0 : 1.0;
                animate opacity {
                    duration: root.main-content-fade-out ? 20ms : 200ms;
                    easing: ease-out-quint;
                }
            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Settings panel
                if root.settings-visible || root._settings-closing: SettingsPanel {
                    panel-visible: root.settings-visible;
                    closing: root._settings-closing;
                    window-position-mode: root.window-position-mode;
                    restore-focus-enabled: root.restore-focus-enabled;
                    done-closing => { root._settings-closing = false; }
                    save-setting(key, value) => { root.save-setting(key, value); }
                    add-mock-data => { root.add-mock-data(); }
                    open-popup-window(title, content) => { root.open-popup-window(title, content); }
                    restore-focus-enabled-change(enabled) => { root.restore-focus-enabled-change(enabled); }
                }

                // Issues panel
                if root.issues-visible: IssuesPanel {
                    issues: root.issues;
                    toggle-issues => { root.toggle-issues(); }
                    select-issue(index) => { root.select-issue(index); }
                }

                // Versions panel
                if root.versions-visible: VersionsPanel {
                    versions: root.versions;
                    toggle-versions => { root.toggle-versions(); }
                    restore-version(version_id) => { root.restore-version(version_id); }
                    delete-version(version_id) => { root.delete-version(version_id); }
                }

                // Share panel
                if root.share-visible || root._share-closing: SharePanel {
                    share-visible: root.share-visible;
                    closing: root._share-closing;
                    done-closing => { root._share-closing = false; }
                }

                // History panel
                if !root.settings-visible && !root._settings-closing && !root.issues-visible && !root.versions-visible && !root.share-visible && !root._share-closing: HistoryPanel {
                    vertical-stretch: 1;
                    clipboard-history: root.clipboard-history;
                    is-scrolling: root.is-scrolling;
                    last-visible-index: root.last-visible-index;
                    copy-item(index) => { root.copy-item(index); }
                    set-hovered-index(index) => { root.set-hovered-index(index); }
                    show-copy-toast => { popup.show(); popup.close(); }
                }
            }

            // Scroll position indicator - shows when scrolling
            if !root.settings-visible && !root._settings-closing && !root.issues-visible && !root.versions-visible && !root.share-visible && !root._share-closing: Rectangle {
                y: parent.height - 55px;
                x: parent.width - 80px;
                width: 70px;
                height: 22px;
                background: ThemeManager.is-dark ? rgba(0, 0, 0, 0.7) : rgba(0, 0, 0, 0.6);
                border-radius: 11px;
                opacity: root.is-scrolling ? 1.0 : 0.0;
                animate opacity {
                    duration: 200ms;
                    easing: ease-out;
                }
                
                Text {
                    text: (root.last-visible-index + 1) + "/" + root.clipboard-history.length;
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        } // End of VerticalLayout

        // Vertical line on toolbar left
        Rectangle {
            width: 1px;
            background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.1);
        }

        // Right toolbar (44px wide) - 拖动区域
        Toolbar {
            settings-visible: root.settings-visible;
            sort-ascending: root.sort-ascending;
            start-drag => { root.start-drag(); }
            toggle-settings => { root.toggle-settings(); }
            clear-history => { root.clear-history(); }
            toggle-sort-order => { root.toggle-sort-order(); }
            toggle-favorite => { root.toggle-favorite(); }
            quit-app => { root.quit-app(); }
            toggle-share => { root.toggle-share(); }
            show-context-menu => { context-menu.show(); }
        }
    }
}

export component PopupTooltipWindow inherits Window {
    width: 200px;
    min-height: 60px;
    max-height: 200px;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in-out property <bool> show-state: false;
    in property <string> content-text: "";
    in property <string> content-timestamp: "";
    in-out property <bool> show-pending: false;
    
    in property <length> mouse-x: 0px;
    in property <length> mouse-y: 0px;
    in property <length> screen-width: 1920px;
    in property <length> screen-height: 1080px;

    callback hide-window();
    callback on-delay-show();

    property <length> tooltip-x: root.mouse-x + 5px;
    property <length> tooltip-y: root.mouse-y + 5px;
    
    property <length> adjusted-x: (tooltip-x + 200px > root.screen-width) ? (root.screen-width - 200px - 5px) : ((tooltip-x < 5px) ? 5px : tooltip-x);
    
    property <length> adjusted-y: (tooltip-y + 200px > root.screen-height) ? (root.screen-height - 200px - 5px) : ((tooltip-y < 5px) ? 5px : tooltip-y);

    x: adjusted-x;
    y: adjusted-y;

    container := Rectangle {
        opacity: 0.0;
        animate opacity { duration: 100ms; easing: ease-in-out; }

        background: rgba(26, 26, 26, 0.97);
        //border-radius: 8px;
        //border-width: 1px;
        //border-color: rgba(255, 255, 255, 0.12);

        states [
            shown when root.show-state: {
                container.opacity: 1.0;
            }
        ]

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            Text {
                text: content-text;
                color: #dddddd;
                font-size: 13px;
                font-weight: 300;
                wrap: word-wrap;
                horizontal-alignment: left;
                vertical-alignment: top;
            }
            
            Rectangle {
                height: 6px;
            }
            
            Rectangle {
                height: 13px;
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: content-timestamp;
                        color: rgba(255, 255, 255, 0.7);
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    Timer {
        interval: 400ms;
        running: root.show-pending && !root.show-state;
        triggered => {
            root.on-delay-show();
        }
    }
}
