import { ScrollView, ListView } from "std-widgets.slint";
import { ThemeManager, DarkTheme, LightTheme } from "themes.slint";
import { FavoriteItem, ClipboardEntryData, ContentKind } from "types.slint";
import { PanelHeader } from "widgets/panel_header.slint";
import { ToggleSwitch } from "widgets/toggle_switch.slint";
import { RadioOption } from "widgets/radio_option.slint";
import { PopupToast } from "widgets/popup_toast.slint";
import { ContextMenu } from "widgets/context_menu.slint";
import { Toolbar } from "widgets/toolbar.slint";
import { FavoriteList } from "widgets/favorite_list.slint";
import { SettingsPanel } from "panels/settings_panel.slint";
import { SharePanel } from "panels/share_panel.slint";
import { HistoryPanel } from "panels/history_panel.slint";
import { AnimationTokens } from "animations.slint";

export global MainContent {
    in-out property <float> opacity: 1.0;
    in-out property <bool> is-fading: false;
}

export component AppWindow inherits Window {
    title: "PasteBridge";
    default-font-family: "JetBrains Mono, Consolas, Courier New, monospace";
    default-font-size: 13px;
    // 初始尺寸由 Rust 端通过 set_initial_width/set_initial_height 设置(从持久化配置加载)
    in-out property <length> initial-width: 280px;
    in-out property <length> initial-height: 396px;
    // 把 preferred-width/height 绑定到 initial-*(Slint 在 show() 时采用 preferred 值)
    preferred-width: self.initial-width;
    preferred-height: self.initial-height;
    min-width: 200px;
    min-height: 300px;
    max-width: 600px;
    max-height: 800px;
    no-frame: true;
    resize-border-width: 8px;
    always-on-top: true;
    background: ThemeManager.is-dark ? #1A1A1ACD : #F5F5F5D5;

    callback minimize-window();
    callback hide-window();
    callback quit-app();
    callback start-drag();
    callback new-clipboard-entry(text: string);
    callback copy-item(index: int);
    callback clear-history();
    callback toggle-settings();
    callback toggle-favorite();
    callback toggle-share();
    callback toggle-sort-order();
    callback show-hover-tooltip(text: string);
    callback show-hover-tooltip-index(index: int);
    callback hide-hover-tooltip();
    callback set-hovered-index(index: int);
    callback on-window-moved();
    callback toggle-theme();
    callback open-popup-window(title: string, content: string);
    callback on-database-updated();
    callback save-setting(key: string, value: string);
    callback restore-focus-enabled-change(enabled: bool);
    callback mouse-hover-focus-enabled-change(enabled: bool);
    callback reset-window-size();
    callback toggle-multi-select(index: int);
    callback toggle-selection(index: int);
    callback clear-multi-select();
    callback add-to-favorite(favorite-index: int, content: string);
    callback drag-over-favorite-button();
    callback end-drag-to-favorite();
    callback cancel-drag-to-favorite();
    callback drag-out-started(index: int);
    callback load-favorite-folder(index: int);
    callback back-to-all-history();
    callback create-favorite-folder(name: string);
    callback delete-favorite-folder(index: int);
    callback toggle-pin();
    callback reorder-favorite(old-index: int, new-index: int);
    callback add-mock-data();
    callback import-from-ditto();
    callback search-history(query: string);
    // 图片懒加载回调
    callback load-visible-images(start-index: int, end-index: int);
    callback add-device();

    in property <[string]> clipboard-history;
    in property <[string]> clipboard-timestamps;
    in property <[ClipboardEntryData]> clipboard-entries;
    in-out property <bool> main-content-fade-out: false;
    in property <string> placeholder-text;

    // Settings panel visibility
    in-out property <bool> settings-visible: false;
    in-out property <bool> share-visible: false;
    // 本机所有可用 IPv4 地址(由 Rust 端枚举填充),用于同步面板左下角展示
    in property <[string]> local-ips: [];

    // Window positioning mode: 0 = golden ratio centered, 1 = follow mouse cursor (fallback when no input focus detected)
    in-out property <int> window-position-mode: 1;
    // Two-way binding with ThemeManager for Rust access
    in-out property <bool> is-dark-mode <=> ThemeManager.is-dark;
    // Sort direction for clipboard history: false = newest first (default), true = oldest first
    in-out property <bool> sort-ascending: false;
    // Focus restoration setting: whether to restore focus to previous app after window shows
    in-out property <bool> restore-focus-enabled: true;
    // Mouse hover focus setting: whether to auto-focus when mouse enters the window
    in-out property <bool> mouse-hover-focus-enabled: true;
    // Pinned state: whether the window stays on top
    in-out property <bool> pinned: false;

    // Scroll indicator visibility (controlled by settings)
    in-out property <bool> scroll-indicator-enabled: true;

    // Scroll indicator properties
    in-out property <int> last-visible-index: 0;

    // Tooltip 状态（来自 popup tooltip 窗口，同步给 search-box 显示）
    in-out property <string> tooltip-text: "";
    in-out property <string> tooltip-timestamp: "";
    in-out property <bool> tooltip-visible: false;

    // Favorite items
    in-out property <[FavoriteItem]> favorite-items;
    in-out property <bool> favorite-list-visible: false;
    in property <int> current-favorite-folder: -1;
    in property <string> current-favorite-folder-name: "";
    in property <[string]> favorite-folder-contents;
    in property <[ClipboardEntryData]> favorite-folder-entries;

    // Multi-select
    in-out property <bool> multi-select-mode: false;
    in property <[bool]> selected-states;
    in property <[string]> multi-select-texts;
    in property <int> selected-count: 0;

    // Search
    in-out property <string> search-query: "";
    in property <bool> has-search-results: true;

    // Toast
    in-out property <string> toast-message: "Copied";
    in-out property <bool> toast-visible: false;

    // Drag state
    in-out property <bool> is-dragging: false;
    in-out property <bool> is-dragging-to-favorite: false;
    in property <string> dragging-text: "";
    in-out property <length> mouse-window-x: 0px;
    in-out property <length> mouse-window-y: 0px;
    in-out property <int> hover-refresh-tick: 0;

    // Flash animation state (driven by Rust on content updates)
    in-out property <bool> settings-flash: false;
    in-out property <bool> share-flash: false;

    // Closing mirror state — set via container's start-closing/done-closing callbacks
    // to keep the panel mounted during the fade-out.
    in-out property <bool> _settings-closing: false;
    in-out property <bool> _share-closing: false;
    in-out property <bool> _favorite-closing: false;

    // Bottom indicator visibility setting (kept for future use; UI was merged into search box)
    in-out property <bool> show-bottom-indicator: true;

    // Size tooltip properties
    in-out property <bool> size-tooltip-visible: false;
    in-out property <int> last-width: 280;
    in-out property <int> last-height: 396;
    property <int> _size-change-tick: 0;
    // 滚动到顶部触发属性
    in-out property <bool> scroll-to-top: false;
    property <bool> _size-save-pending: false;

    // Mutual exclusion: settings and share are mutually exclusive.
    // Setting one to true forces the other to false, which its PanelFadeContainer
    // detects via its own internal state machine and animates the close.
    changed settings-visible => {
        if (root.settings-visible) {
            root.share-visible = false;
        }
    }
    changed share-visible => {
        if (root.share-visible) {
            root.settings-visible = false;
        }
    }

    // 窗口大小变化时触发持久化保存(防抖 1 秒)
    changed width => {
        root._size-save-pending = true;
    }
    changed height => {
        root._size-save-pending = true;
    }

    // Size tooltip auto-hide timer
    size-tooltip-timer := Timer {
        interval: 800ms;
        running: root.size-tooltip-visible;
        triggered => {
            root.size-tooltip-visible = false;
        }
    }

    // Window size save timer (debounced)
    size-save-timer := Timer {
        interval: 1000ms;
        running: root._size-save-pending;
        triggered => {
            root._size-save-pending = false;
            root.save-setting("window-width", round(root.width / 1px));
            root.save-setting("window-height", round(root.height / 1px));
        }
    }

    // Copied 弹出提示
    popup := PopupToast { }

    // 右键上下文菜单
    context-menu := ContextMenu {
        minimize-window => { root.minimize-window(); }
        quit-app => { root.quit-app(); }
    }

    // Background gradient layer (底层)
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: ThemeManager.is-dark ? rgba(0, 0, 0, 0) : rgba(255, 255, 255, 0);
    }

    // White border and shadow container
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: ThemeManager.is-dark ? rgba(0, 0, 0, 0.12) : rgba(255, 255, 255, 0.63);
        border-width: 1px;
        border-color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.15) : rgba(0, 0, 0, 0.1);
    }


    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        //Main content area
            main-content := Rectangle {
                horizontal-stretch: 1;
                opacity: root.main-content-fade-out ? 0.0 : 1.0;
                animate opacity {
                    duration: root.main-content-fade-out ? 20ms : 200ms;
                    easing: ease-out-quint;
                }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Settings panel
                if root.settings-visible || root._settings-closing: SettingsPanel {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    panel-visible: root.settings-visible;
                    flash: root.settings-flash;
                    window-position-mode: root.window-position-mode;
                    restore-focus-enabled: root.restore-focus-enabled;
                    mouse-hover-focus-enabled: root.mouse-hover-focus-enabled;
                    scroll-indicator-enabled: root.scroll-indicator-enabled;
                    start-closing => { root._settings-closing = true; }
                    done-closing => { root._settings-closing = false; }
                    save-setting(key, value) => { root.save-setting(key, value); }
                    add-mock-data => { root.add-mock-data(); }
                    import-from-ditto => { root.import-from-ditto(); }
                    open-popup-window(title, content) => { root.open-popup-window(title, content); }
                    restore-focus-enabled-change(enabled) => { root.restore-focus-enabled-change(enabled); }
                    mouse-hover-focus-enabled-change(enabled) => { root.mouse-hover-focus-enabled-change(enabled); }
                    reset-window-size => { root.reset-window-size(); }
                }

                // Share panel
                if root.share-visible || root._share-closing: SharePanel {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    share-visible: root.share-visible;
                    flash: root.share-flash;
                    local-ips: root.local-ips;
                    start-closing => { root._share-closing = true; }
                    done-closing => { root._share-closing = false; }
                }

                // History panel
                if !root.settings-visible && !root._settings-closing && !root.share-visible && !root._share-closing: HistoryPanel {
                    vertical-stretch: 1;
                    clipboard-history: root.current-favorite-folder >= 0 ? root.favorite-folder-contents : root.clipboard-history;
                    clipboard-entries: root.current-favorite-folder >= 0 ? [] : root.clipboard-entries;
                    clipboard-timestamps: root.clipboard-timestamps;
                    last-visible-index <=> root.last-visible-index;
                    is-dragging <=> root.is-dragging;
                    dragging-index: root.is-dragging ? root.last-visible-index : -1;
                    dragging-text <=> root.dragging-text;
                    favorite-list-visible <=> root.favorite-list-visible;
                    mouse-window-x <=> root.mouse-window-x;
                    mouse-window-y <=> root.mouse-window-y;
                    hover-refresh-tick <=> root.hover-refresh-tick;
                    current-favorite-folder: root.current-favorite-folder;
                    current-favorite-folder-name: root.current-favorite-folder-name;
                    search-query <=> root.search-query;
                    has-search-results: root.has-search-results;
                    tooltip-text: root.tooltip-visible ? root.tooltip-text : "";
                    tooltip-timestamp: root.tooltip-visible ? root.tooltip-timestamp : "";
                    scroll-to-top <=> root.scroll-to-top;
                    copy-item(index) => { root.copy-item(index); }
                    set-hovered-index(index) => { root.set-hovered-index(index); }
                    drag-over-favorite-button => { root.drag-over-favorite-button(); }
                    end-drag-to-favorite => { root.end-drag-to-favorite(); }
                    cancel-drag-to-favorite => { root.cancel-drag-to-favorite(); }
                    drag-out-started(index) => { root.drag-out-started(index); }
                    back-to-all-history => { root.back-to-all-history(); }
                    multi-select-mode <=> root.multi-select-mode;
                    selected-states: root.selected-states;
                    multi-select-texts: root.multi-select-texts;
                    selected-count: root.selected-count;
                    toggle-multi-select(index) => { root.toggle-multi-select(index); }
                    toggle-selection(index) => { root.toggle-selection(index); }
                    clear-multi-select => { root.clear-multi-select(); }
                    search-changed(query) => { root.search-history(query); }
                }
            }

            // Favorite list overlay - floats above history content
            if root.favorite-list-visible || root._favorite-closing: FavoriteList {
                panel-visible: root.favorite-list-visible;
                favorite-items: root.favorite-items;
                dragging-text: root.dragging-text;
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                start-closing => { root._favorite-closing = true; }
                done-closing => { root._favorite-closing = false; }
                reorder(old, new) => { root.reorder-favorite(old, new); }
                add-to-favorite(idx) => { root.add-to-favorite(idx, root.dragging-text); }
                load-favorite-folder(idx) => { root.load-favorite-folder(idx); }
                create-favorite-folder(name) => { root.create-favorite-folder(name); }
                delete-favorite-folder(idx) => { root.delete-favorite-folder(idx); }
            }

            // Size tooltip - floats above history panel
            if !root.settings-visible && !root._settings-closing && !root.share-visible && !root._share-closing && root.size-tooltip-visible: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - 20px - self.height;
                width: size-text.preferred-width + 24px;
                height: 28px;
                background: ThemeManager.is-dark ? rgba(26, 26, 26, 0.95) : rgba(250, 250, 250, 0.95);
                border-radius: 14px;
                border-width: 1px;
                border-color: ThemeManager.is-dark ? rgba(255, 255, 255, 0.15) : rgba(0, 0, 0, 0.1);

                animate opacity {
                    duration: AnimationTokens.tooltip-fade-in;
                    easing: ease-in-out;
                }

                size-text := Text {
                    text: round(root.width / 1px) + " × " + round(root.height / 1px);
                    color: ThemeManager.is-dark ? #e6e6e6 : #1a1a1a;
                    font-size: 12px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        } // close main-content Rectangle

        // Vertical line on toolbar left
        Rectangle {
            width: 1px;
            background: ThemeManager.is-dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.1);
        }

        // Right toolbar (44px wide) - 拖动区域
        // mode: 同步面板打开时切换为同步模式工具栏
        Toolbar {
            mode: root.share-visible ? 1 : 0;
            settings-visible: root.settings-visible;
            sort-ascending: root.sort-ascending;
            favorite-list-visible <=> root.favorite-list-visible;
            is-dragging-to-favorite: root.is-dragging-to-favorite;
            pinned: root.pinned;
            mouse-window-x: root.mouse-window-x;
            mouse-window-y: root.mouse-window-y;
            start-drag => { root.start-drag(); }
            toggle-settings => { root.toggle-settings(); }
            clear-history => { root.clear-history(); }
            toggle-sort-order => { root.toggle-sort-order(); }
            toggle-favorite => { root.toggle-favorite(); }
            quit-app => { root.quit-app(); }
            toggle-share => { root.toggle-share(); }
            toggle-pin => { root.toggle-pin(); }
            show-context-menu => { context-menu.show(); }
            drag-over-favorite-button => { root.drag-over-favorite-button(); }
            end-drag-to-favorite => { root.end-drag-to-favorite(); }
            cancel-drag-to-favorite => { root.cancel-drag-to-favorite(); }
            add-device => { root.add-device(); }
        }
    }
}

export component PopupTooltipWindow inherits Window {
    width: 200px;
    min-height: 60px;
    max-height: 200px;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in-out property <bool> show-state: false;
    in property <string> content-text: "";
    in property <string> content-timestamp: "";
    in-out property <bool> show-pending: false;

    in property <length> mouse-x: 0px;
    in property <length> mouse-y: 0px;
    in property <length> screen-width: 1920px;
    in property <length> screen-height: 1080px;

    callback hide-window();
    callback on-delay-show();

    property <length> tooltip-x: root.mouse-x + 5px;
    property <length> tooltip-y: root.mouse-y + 5px;

    property <length> adjusted-x: (tooltip-x + 200px > root.screen-width) ? (root.screen-width - 200px - 5px) : ((tooltip-x < 5px) ? 5px : tooltip-x);

    property <length> adjusted-y: (tooltip-y + 200px > root.screen-height) ? (root.screen-height - 200px - 5px) : ((tooltip-y < 5px) ? 5px : tooltip-y);

    x: adjusted-x;
    y: adjusted-y;

    container := Rectangle {
        opacity: 0.0;
        animate opacity { duration: 100ms; easing: ease-in-out; }

        background: rgba(26, 26, 26, 0.97);

        states [
            shown when root.show-state: {
                container.opacity: 1.0;
            }
        ]

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            Text {
                text: content-text;
                color: #dddddd;
                font-size: 13px;
                font-weight: 300;
                wrap: word-wrap;
                horizontal-alignment: left;
                vertical-alignment: top;
            }

            Rectangle {
                height: 6px;
            }

            Rectangle {
                height: 13px;
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: content-timestamp;
                        color: rgba(255, 255, 255, 0.7);
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    Timer {
        interval: 400ms;
        running: root.show-pending && !root.show-state;
        triggered => {
            root.on-delay-show();
        }
    }
}